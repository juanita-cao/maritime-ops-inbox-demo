# Copy to .env (never commit .env)
# LLM provider: DeepSeek (OpenAI-compatible API), chosen 2026-09-26
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro   # or deepseek-flash (cheaper)
LLM_BASE_URL=https://api.deepseek.com
LLM_THINKING=disabled      # DeepSeek reasoning; disabled is cheaper and faster for extraction
LLM_MODE=recorded          # recorded (saved responses) or live (real calls, owner confirms first)
CHAT_LLM_MODE=             # the chat only (E16); empty = same as LLM_MODE
DATABASE_PATH=./data/app.sqlite
DEFAULT_UTC_OFFSET=+08:00    # E1: used when an email's sent time has no offset
DEMO_NOW=2026-07-30T18:00:00+08:00   # the demo clock (sample data ends 30 Jul 2026); empty = real time
APP_PASSWORD=                # deployment only: a password for the page; empty = open
LLM_DEBUG_LOG=                # 1 to also write the exact live prompt next to each recording (data/llm_recordings/<node>/<key>.request.json), for the owner to eyeball while testing; empty = off, never written in a normal run
